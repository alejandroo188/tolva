{
  "name": "tolva",
  "version": "0.1.0",
  "private": true,
  "description": "Conversión y edición de imágenes y vídeo, 100% en el navegador.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "design:check": "node scripts/check-design-tokens.ts",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "fixtures:generate": "node scripts/gen-fixtures.ts",
    "sw:generate": "node scripts/gen-sw.ts",
    "licenses:check": "node scripts/check-licenses.ts",
    "notices:generate": "node scripts/gen-third-party-notices.ts",
    "notices:check": "node scripts/gen-third-party-notices.ts --check",
    "budget:check": "node scripts/check-bundle-budget.ts",
    "size": "size-limit",
    "lhci": "lhci autorun",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@jsquash/avif": "2.1.1",
    "@jsquash/jpeg": "1.6.0",
    "@jsquash/jxl": "1.3.0",
    "@jsquash/oxipng": "2.3.0",
    "@jsquash/png": "3.1.1",
    "@jsquash/resize": "2.1.1",
    "@jsquash/webp": "1.5.0",
    "comlink": "4.4.2",
    "exifreader": "4.44.1",
    "fflate": "0.8.3",
    "gifenc": "1.0.3",
    "gifuct-js": "2.1.2",
    "lucide-react": "1.41.0",
    "mediabunny": "1.55.7",
    "nanoid": "6.0.1",
    "next": "16.3.4",
    "next-themes": "0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "utif2": "4.1.0",
    "wasm-feature-detect": "1.9.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.63.0",
    "@size-limit/file": "13.0.3",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "happy-dom": "20.14.0",
    "husky": "9.1.7",
    "license-checker-rseidelsohn": "5.0.1",
    "lint-staged": "17.5.0",
    "prettier": "3.9.6",
    "serve": "14.2.6",
    "size-limit": "13.0.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
